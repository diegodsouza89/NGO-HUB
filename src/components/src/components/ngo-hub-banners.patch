+  "templates": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 140\" preserveAspectRatio=\"xMidYMid slice\" width=\"100%\" height=\"100%\"><defs><linearGradient id=\"gt\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#fff7ed\"/><stop offset=\"1\" stop-color=\"#fed7aa\"/></linearGradient></defs><rect width=\"400\" height=\"140\" fill=\"url(#gt)\"/><circle cx=\"20\" cy=\"130\" r=\"60\" fill=\"#fff\" opacity=\".35\"/><circle cx=\"385\" cy=\"10\" r=\"45\" fill=\"#fff\" opacity=\".35\"/>\n    <rect x=\"84\" y=\"34\" width=\"80\" height=\"96\" rx=\"7\" fill=\"#fff\" stroke=\"#fdba74\" stroke-width=\"3\" transform=\"rotate(-8 124 82)\"/>\n    <rect x=\"104\" y=\"24\" width=\"80\" height=\"100\" rx=\"7\" fill=\"#fff\" stroke=\"#ea580c\" stroke-width=\"3\"/>\n    <g stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\"><g stroke=\"#ea580c\" stroke-width=\"3.5\"><path d=\"M116 46l4 4 8-8M116 70l4 4 8-8M116 94l4 4 8-8\"/></g><g stroke=\"#fdba74\" stroke-width=\"5\"><path d=\"M138 46h34M138 70h28M138 94h32\"/></g></g>\n    <g transform=\"translate(290 54)\"><path d=\"M0 0l50-22 50 22-50 22z\" fill=\"#c2410c\"/><path d=\"M22 10v22c0 10 56 10 56 0V10L50 22z\" fill=\"#ea580c\"/><path d=\"M92 4v26\" stroke=\"#c2410c\" stroke-width=\"3\"/><circle cx=\"92\" cy=\"32\" r=\"5\" fill=\"#fbbf24\"/></g></svg>"
+};
+
+// Match on the category's English name so no data changes are needed.
+// Order matters: the first matching rule wins.
+const MATCH: [RegExp, string][] = [
+  [/cyber|security|safety|backup/i, "security"],
+  [/email|document|meeting|workspace|productivity|communication|outreach/i, "email"],
+  [/hosting|cloud|website|digital presence|developer|technical/i, "cloud"],
+  [/programme|program|operations|crm|fundrais|monitoring|evaluation|data/i, "programme"],
+  [/design|creative|\bai\b/i, "design"],
+  [/template|sop|training|getting started|eligibility/i, "templates"],
+];
+
+const KEYS = Object.keys(ART);
+
+export default function CategoryArt({ title }: { title: string }) {
+  let key = MATCH.find(([re]) => re.test(title))?.[1];
+  if (!key) {
+    // Unknown category: pick a stable banner from its name so every card still gets one.
+    let h = 0;
+    for (const ch of title) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
+    key = KEYS[h % KEYS.length];
+  }
+  return (
+    <div
+      aria-hidden="true"
+      className="-mx-6 -mt-6 mb-5 h-32 overflow-hidden border-b border-slate-200 [&>svg]:transition-transform [&>svg]:duration-500 group-hover:[&>svg]:scale-105"
+      dangerouslySetInnerHTML={{ __html: ART[key] }}
+    />
+  );
+}
