+  "security": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 140\" preserveAspectRatio=\"xMidYMid slice\" width=\"100%\" height=\"100%\"><defs><linearGradient id=\"gs\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#ecfdf5\"/><stop offset=\"1\" stop-color=\"#a7f3d0\"/></linearGradient></defs><rect width=\"400\" height=\"140\" fill=\"url(#gs)\"/><circle cx=\"20\" cy=\"130\" r=\"60\" fill=\"#fff\" opacity=\".35\"/><circle cx=\"385\" cy=\"10\" r=\"45\" fill=\"#fff\" opacity=\".35\"/><defs><pattern id=\"dots\" width=\"16\" height=\"16\" patternUnits=\"userSpaceOnUse\"><circle cx=\"2\" cy=\"2\" r=\"2\" fill=\"#10b981\" opacity=\".25\"/></pattern></defs>\n    <rect x=\"28\" y=\"28\" width=\"140\" height=\"96\" fill=\"url(#dots)\"/>\n    <path d=\"M200 18l58 20v34c0 32-26 50-58 60-32-10-58-28-58-60V38z\" fill=\"#fff\" stroke=\"#059669\" stroke-width=\"3.5\"/>\n    <rect x=\"180\" y=\"68\" width=\"40\" height=\"32\" rx=\"5\" fill=\"#059669\"/>\n    <path d=\"M188 68v-10a12 12 0 0 1 24 0v10\" fill=\"none\" stroke=\"#059669\" stroke-width=\"4\"/>\n    <circle cx=\"200\" cy=\"82\" r=\"4\" fill=\"#fff\"/><path d=\"M200 84v8\" stroke=\"#fff\" stroke-width=\"3\"/>\n    <g transform=\"translate(300 60) rotate(-30)\"><circle r=\"14\" fill=\"none\" stroke=\"#047857\" stroke-width=\"4\"/><path d=\"M14 0h44M46 0v10M54 0v8\" stroke=\"#047857\" stroke-width=\"4\" stroke-linecap=\"round\"/></g></svg>",
+  "programme": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 140\" preserveAspectRatio=\"xMidYMid slice\" width=\"100%\" height=\"100%\"><defs><linearGradient id=\"gp\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#fffbeb\"/><stop offset=\"1\" stop-color=\"#fde68a\"/></linearGradient></defs><rect width=\"400\" height=\"140\" fill=\"url(#gp)\"/><circle cx=\"20\" cy=\"130\" r=\"60\" fill=\"#fff\" opacity=\".35\"/><circle cx=\"385\" cy=\"10\" r=\"45\" fill=\"#fff\" opacity=\".35\"/>\n    <rect x=\"50\" y=\"24\" width=\"150\" height=\"96\" rx=\"9\" fill=\"#fff\" stroke=\"#d97706\" stroke-width=\"3\"/>\n    <g fill=\"#f59e0b\"><rect x=\"68\" y=\"80\" width=\"18\" height=\"26\" rx=\"3\"/><rect x=\"94\" y=\"64\" width=\"18\" height=\"42\" rx=\"3\"/><rect x=\"120\" y=\"72\" width=\"18\" height=\"34\" rx=\"3\"/><rect x=\"146\" y=\"48\" width=\"18\" height=\"58\" rx=\"3\"/></g>\n    <polyline points=\"66,60 102,44 128,52 170,34\" fill=\"none\" stroke=\"#b45309\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    <rect x=\"232\" y=\"30\" width=\"66\" height=\"88\" rx=\"7\" fill=\"#fff\" stroke=\"#b45309\" stroke-width=\"3\"/><rect x=\"250\" y=\"24\" width=\"30\" height=\"12\" rx=\"4\" fill=\"#b45309\"/>\n    <g stroke=\"#f59e0b\" stroke-width=\"4\" stroke-linecap=\"round\" fill=\"none\"><path d=\"M244 58l5 5 9-10M244 82l5 5 9-10\"/><path d=\"M266 60h20M266 84h20\"/></g>\n    <g fill=\"#d97706\"><circle cx=\"338\" cy=\"56\" r=\"10\"/><path d=\"M320 92c2-16 34-16 36 0z\"/></g>\n    <g fill=\"#fbbf24\"><circle cx=\"362\" cy=\"70\" r=\"8\"/><path d=\"M348 98c2-13 26-13 28 0z\"/></g></svg>",
